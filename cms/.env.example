# Neon PostgreSQL — copy to cms/.env and fill in real values.
# Never commit cms/.env.
#
# From the Neon console: Project → Connection details.
# Use the pooled URI for DATABASE_URL and the direct (non-pooler) URI for DIRECT_URL.
# Prisma migrations need DIRECT_URL. If you only have one URI, set both to the same value.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Server-only key for machine automation (header x-cms-key).
# Never prefix with NEXT_PUBLIC_. Never commit the real value.
CMS_API_SECRET="generate-a-long-random-string"

# First administrator seed (Phase 3A). Used by npm run auth:bootstrap
# and POST /api/auth/bootstrap when the User table is empty.
# Never prefix with NEXT_PUBLIC_. Never commit the real password.
CMS_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
CMS_BOOTSTRAP_ADMIN_PASSWORD="generate-a-long-random-password"

# Optional public origin for CSRF Origin checks (no trailing slash).
# CMS_PUBLIC_ORIGIN="https://elitex-interior.vercel.app"

# Optional extra browser origins allowed to call public GET /api/content and /api/media.
# https://elitexinterior.com and localhost are always allowed. Comma-separated.
# CMS_PUBLIC_SITE_ORIGINS="https://example.com"

# Cloudinary — server-only. Reuse the existing cloud (dpdmb5t1l). Do not create a new account.
# CLOUDINARY_CLOUD_NAME="dpdmb5t1l"
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_UPLOAD_PRESET=""
