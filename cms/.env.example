# Neon PostgreSQL — copy to cms/.env and fill in real values.
# Never commit cms/.env.
#
# From the Neon console: Project → Connection details.
# Use the pooled URI for DATABASE_URL and the direct (non-pooler) URI for DIRECT_URL.
# Prisma migrations need DIRECT_URL. If you only have one URI, set both to the same value.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
